# Auto detect text files and normalize line endings to LF
* text=auto

# C# files
*.cs text eol=lf

# Solution and project files
*.sln text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf

# Config files
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.config text eol=lf
.editorconfig text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Scripts
*.sh text eol=lf
*.ps1 text eol=lf

# Docker
Dockerfile* text eol=lf
.dockerignore text eol=lf
docker-compose*.yml text eol=lf

# Binary files
*.dll binary
*.pdb binary
*.exe binary
*.so binary
*.dylib binary
