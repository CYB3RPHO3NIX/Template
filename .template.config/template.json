{
  "$schema": "http://json.schemastore.org/template",
  "author": "Enterprise Architecture Team",
  "classifications": [
    "Common",
    "Console",
    "Backend",
    "CQRS",
    "Microservice"
  ],
  "name": "Enterprise CQRS Microservice",
  "identity": "Enterprise.CQRS.Microservice",
  "shortName": "cqrs-microservice",
  "description": "A complete CQRS (Command Query Responsibility Segregation) microservice template with DDD, event sourcing, and message queue support (InMemory, RabbitMQ, Kafka, Azure Service Bus)",
  "version": "1.0.0",
  "tags": {
    "language": "C#",
    "type": "project",
    "framework": ".NET",
    "architecture": "CQRS"
  },
  "sourceName": "Template",
  "preferNameAsDefaultName": false,
  "exclude": [
    "**/[Bb]in/**",
    "**/[Oo]bj/**",
    "**/.vs/**",
    "**/.git/**",
    "**/.vscode/**",
    "**/node_modules/**",
    "**/*.user",
    "**/*.log"
  ],
  "symbols": {
    "ServiceName": {
      "type": "parameter",
      "description": "The name of your microservice (e.g., InvoiceService, OrderService)",
      "datatype": "text",
      "replaces": "Template",
      "fileRename": "Template",
      "binding": "ProjectName"
    },
    "CompanyName": {
      "type": "parameter",
      "description": "Your company name (optional)",
      "datatype": "text",
      "defaultValue": "Enterprise",
      "replaces": "Enterprise",
      "globalReplacement": true
    }
  },
  "forms": {
    "vs-2022": {
      "name": "Visual Studio 2022",
      "description": "Visual Studio 2022 Compatibility"
    }
  },
}
