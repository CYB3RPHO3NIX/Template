{
  "$schema": "http://json.schemastore.org/template",
  "author": "Enterprise Architecture Team",
  "classifications": [
    "Common",
    "Console",
    "Backend",
    "CQRS",
    "Microservice"
  ],
  "name": "Enterprise CQRS Microservice",
  "identity": "Enterprise.CQRS.Microservice",
  "shortName": "cqrs-microservice",
  "description": "A complete CQRS (Command Query Responsibility Segregation) microservice template with DDD, event sourcing, and message queue support (InMemory, RabbitMQ, Kafka, Azure Service Bus)",
  "version": "1.0.0",
  "tags": {
    "language": "C#",
    "type": "project",
    "framework": ".NET",
    "architecture": "CQRS"
  },
  "sourceName": "Template",
  "preferNameAsDefaultName": true,
  "symbols": {
    "ServiceName": {
      "type": "parameter",
      "description": "The name of your microservice (e.g., InvoiceService, OrderService)",
      "replaces": "Template",
      "fileRename": "Template",
      "defaultValue": "MyMicroservice"
    },
    "RootNamespace": {
      "type": "derived",
      "valueSource": "ServiceName",
      "valueTransform": "PascalCase",
      "replaces": "Template",
      "description": "The root namespace for the project"
    },
    "CompanyName": {
      "type": "parameter",
      "description": "Your company name (optional)",
      "defaultValue": "Enterprise",
      "replaces": "Enterprise",
      "globalReplacement": true
    }
  },
  "postActions": [
    {
      "id": "restore",
      "description": "Restore NuGet packages",
      "actionId": "210D431B-A78B-4D2F-B762-4F2289A3F200",
      "args": {
        "files": "*.sln"
      },
      "continueOnError": true
    },
    {
      "id": "openSolution",
      "description": "Open the solution in Visual Studio",
      "actionId": "84C0DA21-51C8-4541-9E7C-61978820175F",
      "args": {
        "files": "*.sln"
      },
      "continueOnError": true
    }
  ]
}
